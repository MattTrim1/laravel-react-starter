    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@types/react": "^19.0.3",
        "@types/react-dom": "^19.0.2",
        "concurrently": "^9.0.1",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-react": "^7.37.3",
        "eslint-plugin-react-hooks": "^5.2.0",
        "globals": "^15.14.0",
        "prettier": "^3.4.2",
